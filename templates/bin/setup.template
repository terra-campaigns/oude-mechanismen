#!/usr/bin/env bash
#
# setup — Idempotent environment setup for campaign repository.
#
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Expand standard paths and UTF-8 locale for Homebrew, asdf, rbenv, mise, etc.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.rbenv/shims:$HOME/.asdf/shims:$HOME/.local/share/mise/shims:$PATH"
export LC_ALL="${LC_ALL:-en_GB.UTF-8}"
export LANG="${LANG:-en_GB.UTF-8}"

echo "==> Setting up campaign environment in $REPO_ROOT..."

# 1. Configure Git hooks
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$REPO_ROOT" config core.hooksPath .githooks 2>/dev/null || true
  if [ -f "$REPO_ROOT/.githooks/pre-commit" ]; then
    chmod +x "$REPO_ROOT/.githooks/pre-commit"
  fi
  echo "  ✓ Configured Git hooks (.githooks/pre-commit)"
fi

# 2. Ensure Ruby gems are installed
bundle check || bundle install

# 3. Compile Jekyll site
bundle exec jekyll build

# 4. Check for oude CLI installation
if command -v oude >/dev/null 2>&1; then
  oude doctor
else
  echo "  ⚠ Warning: oude CLI not found in PATH. Install via uv tool install."
fi

echo "==> Setup complete! Your campaign environment is ready."
