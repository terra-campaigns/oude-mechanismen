#!/usr/bin/env bash
#
# setup — Idempotent environment setup for campaign repository.
#
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "==> Setting up campaign environment in $REPO_ROOT..."

# 1. Check for shared engine (oude-mechanismen)
ENGINE_DIR=""
if [ -n "$OUDE_MECHANISMEN_DIR" ] && [ -d "$OUDE_MECHANISMEN_DIR" ]; then
  ENGINE_DIR="$OUDE_MECHANISMEN_DIR"
elif [ -d "$REPO_ROOT/../oude-mechanismen" ]; then
  ENGINE_DIR="$(cd "$REPO_ROOT/../oude-mechanismen" && pwd)"
elif [ -d "$HOME/Repos/oude-mechanismen" ]; then
  ENGINE_DIR="$(cd "$HOME/Repos/oude-mechanismen" && pwd)"
elif [ -d "$REPO_ROOT/.engine" ]; then
  ENGINE_DIR="$(cd "$REPO_ROOT/.engine" && pwd)"
fi

if [ -n "$ENGINE_DIR" ]; then
  echo "  ✓ Discovered engine at $ENGINE_DIR"
else
  echo "  ⚠ Warning: oude-mechanismen engine not found in standard paths."
  echo "    Recommended: git clone <oude-mechanismen-url> \"$REPO_ROOT/../oude-mechanismen\""
  echo "    Or set: export OUDE_MECHANISMEN_DIR=/path/to/oude-mechanismen"
fi

# 2. Configure Git hooks
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$REPO_ROOT" config core.hooksPath .githooks 2>/dev/null || true
  if [ -f "$REPO_ROOT/.githooks/pre-commit" ]; then
    chmod +x "$REPO_ROOT/.githooks/pre-commit"
  fi
  echo "  ✓ Configured Git hooks (.githooks/pre-commit)"
fi

# 3. Initialize Python virtual environment (.agents/venv)
VENV_DIR="$REPO_ROOT/.agents/venv"
if [ ! -d "$VENV_DIR" ]; then
  echo "  -> Creating Python virtual environment in $VENV_DIR..."
  python3 -m venv "$VENV_DIR"
fi

if [ -f "$REPO_ROOT/.agents/requirements.txt" ]; then
  echo "  -> Installing Python requirements..."
  "$VENV_DIR/bin/pip" install --quiet -r "$REPO_ROOT/.agents/requirements.txt"
  echo "  ✓ Python virtual environment ready (pyyaml, pypdf)"
fi

# 4. Ensure script runners are executable
for SCRIPT in "$REPO_ROOT/.agents/scripts"/*.py; do
  if [ -f "$SCRIPT" ]; then
    chmod +x "$SCRIPT"
  fi
done

# 5. Verify Tier 1 catalogue compilation
if [ -f "$REPO_ROOT/_plugins/data_extractor.rb" ]; then
  echo "  -> Validating Tier 1 catalogue compilation..."
  (cd "$REPO_ROOT" && ruby --disable-gems _plugins/data_extractor.rb >/dev/null 2>&1 || true)
  if [ -f "$REPO_ROOT/.agents/context/catalog.json" ]; then
    echo "  ✓ Tier 1 catalogue compiled successfully (.agents/context/catalog.json)"
  fi
fi

echo "==> Setup complete! Your campaign environment is ready."
